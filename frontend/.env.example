# ==============================================================================
# SentinelAI Frontend Client Configuration (Vite)
# ==============================================================================
# IMPORTANT:
# All variables prefixed with VITE_ are embedded into the client bundle and
# exposed publicly to the browser. NEVER place private secrets, passwords,
# database credentials, or private API tokens in this file or any .env file.
# ==============================================================================

# Backend API Base URL
# Local development default: http://localhost:8000
# LinuxONE deployment example: http://192.168.1.50:8000 or https://sentinel.internal:8000
VITE_API_BASE_URL=http://localhost:8000

# Client Request Timeout (milliseconds)
VITE_API_TIMEOUT_MS=5000

# Telemetry Auto-Polling Interval (seconds; 0 = manual polling only)
VITE_POLLING_INTERVAL_SEC=30

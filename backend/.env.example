# SentinelAI FastAPI Backend Environment Configuration
# Copy this file to .env for local overrides (never commit populated .env)

# Application Settings
APP_NAME=SentinelAI Backend
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Settings
# Use SQLite for initial local development and tests
DATABASE_URL=sqlite:///./sentinel.db

# CORS Configuration (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Seeding & Initialization
# Automatically seed configured cameras and zones on empty database startup
SEED_CONFIGURED_ASSETS=true

# Logging
LOG_LEVEL=INFO

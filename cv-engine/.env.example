# ====================================================
# SentinelAI CV Engine - Local Environment Configuration
# ====================================================
# Safe development defaults. Copy to .env for local overrides.
# DO NOT commit real secrets or credentials to version control.

# --- Input Video Source Configuration ---
# Source type: "file", "camera", "stream", or "replay"
CV_INPUT_SOURCE_TYPE=file
# Path to authorized sample video or camera index (e.g., 0, "sample-data/demo.mp4")
CV_VIDEO_SOURCE=sample-data/demo.mp4
# Camera and location identifier
CV_CAMERA_ID=cam-demo-01

# --- Processing Dimensions & Framerate ---
# Target dimensions for frame analysis (optional, positive integers)
CV_TARGET_WIDTH=1280
CV_TARGET_HEIGHT=720
# Target processing rate in frames per second
CV_TARGET_FPS=10.0

# --- Logging Configuration ---
# Valid log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
CV_LOG_LEVEL=INFO

# --- Future Phase Placeholders: Detector Configuration (Phase 2+) ---
# Note: Actual detection models are not loaded in Phase 1.
CV_MODEL_TYPE=placeholder
CV_MODEL_PATH=
CV_CONFIDENCE_THRESHOLD=0.50

# --- Future Phase Placeholders: Zone & Event Rules (Phase 3+) ---
CV_ZONE_ID=zone-restricted-01
# Deduplication cooldown in seconds to prevent event flooding
CV_DEDUPLICATION_COOLDOWN_SEC=5.0
# Number of consecutive positive frames required before confirming event
CV_TEMPORAL_CONFIRMATION_FRAMES=3
# Replay fallback mode: when true, runs deterministic replay if live inference is unavailable
CV_REPLAY_MODE=false

# --- Backend API Target ---
# Base URL for backend event ingestion (per API_CONTRACT.md)
CV_BACKEND_URL=http://localhost:8000

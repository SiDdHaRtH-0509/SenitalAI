# ====================================================
# SentinelAI CV Engine - Local Environment Configuration
# ====================================================
# Safe development defaults. Copy to .env for local overrides.
# DO NOT commit real secrets or credentials to version control.

# --- Input Video Source Configuration ---
# Source type: "file", "camera", "stream", or "replay"
CV_INPUT_SOURCE_TYPE=file
# Path to authorized sample video, RTSP URL, or camera device index (e.g., 0, "sample-data/demo.mp4")
CV_VIDEO_SOURCE=sample-data/demo.mp4
# Camera and location identifier matching API_CONTRACT.md
CV_CAMERA_ID=cam-demo-01

# --- Processing Dimensions & Framerate ---
# Target dimensions for frame analysis (optional, positive integers)
CV_TARGET_WIDTH=1280
CV_TARGET_HEIGHT=720
# Target processing rate in frames per second
CV_TARGET_FPS=10.0

# --- Logging Configuration ---
# Valid log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
CV_LOG_LEVEL=INFO

# --- Detector Configuration ---
# Model type: "yolo", "mock", or "replay"
CV_MODEL_TYPE=yolo
# Model weight path or identifier (e.g., "yolov8n.pt", "mock")
CV_MODEL_PATH=yolov8n.pt
# Statistical confidence threshold for person detections [0.0 - 1.0]
CV_CONFIDENCE_THRESHOLD=0.50

# --- Zone & Geometry Configuration ---
# Identifier and name of the primary monitored restricted zone
CV_ZONE_ID=zone-restricted-01
CV_ZONE_NAME=Restricted Zone 01
# Ground-plane foot-contact reference point strategy: "bottom_center" or "center"
CV_REFERENCE_POINT_STRATEGY=bottom_center
# Optional JSON array of multi-zone definitions (overrides single zone)
# CV_ZONES_JSON='[{"zone_id":"z1","name":"Zone 1","vertices":[[0,0],[100,0],[100,100],[0,100]],"enabled":true}]'

# --- Event Generation & Deduplication Policy ---
# Enable or disable security event generation and backend submission
CV_EVENTS_ENABLED=true
# Observable severity rating: "LOW", "MEDIUM", "HIGH", or "CRITICAL"
CV_EVENT_SEVERITY=HIGH
# Number of consecutive inside frames required to confirm an incursion (debouncing)
CV_TEMPORAL_CONFIRMATION_FRAMES=1
# Deduplication cooldown window in seconds per zone to prevent event flooding
CV_DEDUPLICATION_COOLDOWN_SEC=5.0
# Base ISO-8601 timestamp for presentation timestamps
CV_BASE_TIMESTAMP=2026-10-17T09:30:00Z
# Deterministic replay fallback mode (true/false)
CV_REPLAY_MODE=false

# --- Backend API Target ---
# Base URL for backend event ingestion (per API_CONTRACT.md)
CV_BACKEND_URL=http://localhost:8000
# HTTP connection and response timeout in seconds
CV_API_TIMEOUT=5.0
# Maximum bounded retries for transient 5xx server errors
CV_API_MAX_RETRIES=2

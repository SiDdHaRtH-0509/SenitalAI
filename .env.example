# ==============================================================================
# SentinelAI Enterprise Environment Configuration Template
# ==============================================================================
# Copy this template to .env and configure environment-specific values.
# NEVER commit the actual .env file or production secrets to Git.
# ==============================================================================

# Core Application Settings
APP_NAME=SentinelAI Backend
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=sqlite:///./sentinel.db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Asset Seeding (seeds default camera registry and boundary zones on boot)
SEED_CONFIGURED_ASSETS=true
LOG_LEVEL=INFO

# ==============================================================================
# Authentication & Cryptographic Security
# ==============================================================================
AUTH_ENABLED=true

# JWT Signing Key
# MANDATORY IN PRODUCTION: Generate a high-entropy secret (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=replace_with_a_secure_random_secret_in_production

# JWT Expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60
SERVICE_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256

# Machine-to-Machine (M2M) Service API Key for CV Engine Ingestion
# MANDATORY IN PRODUCTION: Generate a unique high-entropy API key
SENTINEL_SERVICE_API_KEY=replace_with_a_secure_service_key_in_production

# Default Initial Account Passwords (seeded on first database initialization)
# In production, change default passwords immediately after initial deployment.
ADMIN_DEFAULT_PASSWORD=replace_with_secure_admin_password
OPERATOR_DEFAULT_PASSWORD=replace_with_secure_operator_password
SERVICE_DEFAULT_PASSWORD=replace_with_secure_service_password
